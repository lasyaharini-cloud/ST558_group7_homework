# import readxl package
library(readxl)
# read in white wine data and create df
white_wine_df <- read_excel("data/white-wine.xlsx")
# get col names from the second sheet in white wine dataset
wine_col_names <- read_xlsx("data/white-wine.xlsx", sheet = excel_sheets("data/white-wine.xlsx")[2])
wine_col_names
# set new col names from the second sheet
colnames(white_wine_df) <- wine_col_names$Variables
white_wine_df$type <- "white"
# read in red wine csv
red_wine_df <- read_delim("https://www4.stat.ncsu.edu/~online/datasets/red-wine.csv", delim= ";")
# set col names with col names from the csv
colnames(red_wine_df) <- wine_col_names$Variables
red_wine_df$type <- "red"
full_wine_df <- bind_rows(white_wine_df, red_wine_df)
full_wine_df
# filter based on conditions
full_wine_df <- full_wine_df |>
filter(quality > 6.5, alcohol < 13.2)
full_wine_df
# Sort the wines from highest quality to lowest quality
full_wine_df <- full_wine_df |>
arrange(desc(quality))
full_wine_df
# Select acid related variables along with alcohol, type, and quality
full_wine_df <- full_wine_df |>
select(contains("acid"), alcohol, type, quality)
full_wine_df
# Group the wines by quality and add the mean and standard deviation of alcohol for each quality group
full_wine_df |>
group_by(quality) |>
mutate(
mean_alcohol = mean(alcohol),
sd_alcohol = sd(alcohol)
)
library(DBI)
# Connect to the Lahman SQLite database
con <- dbConnect(RSQLite::SQLite(), "data/lahman.db")
dbListTables(con)
# Access the Teams table and keep only records from 2015
tbl(con, "Teams") |> filter(yearID == 2015)
# Use SQL to return all Teams records from 2015
tbl(con, sql("SELECT *
FROM Teams
WHERE (yearID = 2015)"))
# Return hall of fame with the requested variables
HOF_tbl <- tbl(con, "HallOfFame") |>
filter(inducted == "Y") |>
select(playerID, yearID, category)
HOF_tbl
# Select player names from the People table and join them with the Hall of Fame results using playerID
HOF_full_tbl <- inner_join(
tbl(con, "People") |>
select(playerID, nameFirst, nameLast),
HOF_tbl,
by = join_by(playerID == playerID)
)
HOF_full_tbl
# Select the manager ID, games, wins, and losses and calculate career totals for each manager
manager_tbl <- tbl(con, "Managers") |>
select(playerID, G, W, L) |>
group_by(playerID) |>
summarize(
G_managed = sum(G, na.rm = TRUE),
Total_W = sum(W, na.rm = TRUE),
Total_L = sum(L, na.rm = TRUE)
) |>
collect() |>
mutate(career_win_loss = Total_W / G_managed) |>
# Sort from highest to lowest career win/loss percentage
arrange(desc(career_win_loss))
manager_tbl
# Join HOF and managers table
hof_managers <- HOF_full_tbl |>
collect() |>
inner_join(
manager_tbl,
by = "playerID"
)
hof_managers
